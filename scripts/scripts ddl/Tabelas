CREATE TABLE Aluno (
    id_aluno        INT IDENTITY(1,1) NOT NULL,
    nome            VARCHAR(100) NOT NULL,
    cpf             CHAR(11)     NOT NULL,          -- somente dígitos
    email           VARCHAR(100) NOT NULL,
    data_nascimento DATE         NOT NULL,
    telefone        VARCHAR(11)  NULL,              -- DDD + número, só dígitos
    genero          CHAR(1)      NULL,
    ativo           BIT          NOT NULL CONSTRAINT DF_Aluno_ativo DEFAULT 1,
    CONSTRAINT PK_Aluno PRIMARY KEY (id_aluno),
    CONSTRAINT UQ_Aluno_cpf   UNIQUE (cpf),
    CONSTRAINT UQ_Aluno_email UNIQUE (email),
    CONSTRAINT CK_Aluno_cpf      CHECK (cpf NOT LIKE '%[^0-9]%'),
    CONSTRAINT CK_Aluno_email    CHECK (email LIKE '%_@_%._%'),
    CONSTRAINT CK_Aluno_telefone CHECK (telefone IS NULL OR telefone NOT LIKE '%[^0-9]%'),
    CONSTRAINT CK_Aluno_genero   CHECK (genero IN ('M','F','O')),
    CONSTRAINT CK_Aluno_nasc     CHECK (data_nascimento >= '1900-01-01')
);
GO

CREATE TABLE Plano (
    id_plano       TINYINT IDENTITY(1,1) NOT NULL,   -- catálogo pequeno (máx. 255)
    nome           VARCHAR(40)  NOT NULL,
    descricao      VARCHAR(100) NULL,
    valor          DECIMAL(7,2) NOT NULL,
    duracao_meses  TINYINT      NOT NULL,
    ativo          BIT          NOT NULL CONSTRAINT DF_Plano_ativo DEFAULT 1,
    CONSTRAINT PK_Plano PRIMARY KEY (id_plano),
    CONSTRAINT UQ_Plano_nome UNIQUE (nome),
    CONSTRAINT CK_Plano_valor   CHECK (valor > 0),
    CONSTRAINT CK_Plano_duracao CHECK (duracao_meses BETWEEN 1 AND 36)
);
GO

CREATE TABLE Instrutor (
    id_instrutor  SMALLINT IDENTITY(1,1) NOT NULL,
    nome          VARCHAR(100) NOT NULL,
    cpf           CHAR(11)     NOT NULL,
    email         VARCHAR(100) NOT NULL,
    especialidade VARCHAR(40)  NULL,
    telefone      VARCHAR(11)  NULL,
    ativo         BIT          NOT NULL CONSTRAINT DF_Instrutor_ativo DEFAULT 1,
    CONSTRAINT PK_Instrutor PRIMARY KEY (id_instrutor),
    CONSTRAINT UQ_Instrutor_cpf   UNIQUE (cpf),
    CONSTRAINT UQ_Instrutor_email UNIQUE (email),
    CONSTRAINT CK_Instrutor_cpf      CHECK (cpf NOT LIKE '%[^0-9]%'),
    CONSTRAINT CK_Instrutor_email    CHECK (email LIKE '%_@_%._%'),
    CONSTRAINT CK_Instrutor_telefone CHECK (telefone IS NULL OR telefone NOT LIKE '%[^0-9]%')
);
GO

CREATE TABLE Modalidade (
    id_modalidade TINYINT IDENTITY(1,1) NOT NULL,
    nome          VARCHAR(40)  NOT NULL,
    descricao     VARCHAR(100) NULL,
    CONSTRAINT PK_Modalidade PRIMARY KEY (id_modalidade),
    CONSTRAINT UQ_Modalidade_nome UNIQUE (nome)
);
GO

CREATE TABLE Exercicio (
    id_exercicio   SMALLINT IDENTITY(1,1) NOT NULL,
    nome           VARCHAR(50)  NOT NULL,
    grupo_muscular VARCHAR(30)  NOT NULL,
    descricao      VARCHAR(100) NULL,
    CONSTRAINT PK_Exercicio PRIMARY KEY (id_exercicio),
    CONSTRAINT UQ_Exercicio_nome UNIQUE (nome)
);
GO

/* ---------- Tabelas dependentes ---------- */

CREATE TABLE Assinatura (
    id_assinatura INT IDENTITY(1,1) NOT NULL,
    id_aluno      INT          NOT NULL,
    id_plano      TINYINT      NOT NULL,
    data_inicio   DATE         NOT NULL,
    data_fim      DATE         NOT NULL,
    status        VARCHAR(10)  NOT NULL CONSTRAINT DF_Assinatura_status DEFAULT 'Ativa',
    valor_mensal  DECIMAL(7,2) NOT NULL,            -- preço do plano na data da contratação
    CONSTRAINT PK_Assinatura PRIMARY KEY (id_assinatura),
    CONSTRAINT FK_Assinatura_Aluno FOREIGN KEY (id_aluno) REFERENCES Aluno(id_aluno),
    CONSTRAINT FK_Assinatura_Plano FOREIGN KEY (id_plano) REFERENCES Plano(id_plano),
    CONSTRAINT CK_Assinatura_status CHECK (status IN ('Ativa','Suspensa','Vencida','Cancelada')),
    CONSTRAINT CK_Assinatura_datas  CHECK (data_fim >= data_inicio),
    CONSTRAINT CK_Assinatura_valor  CHECK (valor_mensal > 0)
);
GO

CREATE TABLE Pagamento (
    id_pagamento     INT IDENTITY(1,1) NOT NULL,
    id_assinatura    INT          NOT NULL,
    data_pagamento   DATE         NOT NULL,
    valor            DECIMAL(7,2) NOT NULL,
    metodo_pagamento VARCHAR(8)   NOT NULL,
    status           VARCHAR(10)  NOT NULL CONSTRAINT DF_Pagamento_status DEFAULT 'Pendente',
    referencia       VARCHAR(20)  NULL,
    CONSTRAINT PK_Pagamento PRIMARY KEY (id_pagamento),
    CONSTRAINT FK_Pagamento_Assinatura FOREIGN KEY (id_assinatura) REFERENCES Assinatura(id_assinatura),
    CONSTRAINT CK_Pagamento_valor  CHECK (valor > 0),
    CONSTRAINT CK_Pagamento_metodo CHECK (metodo_pagamento IN ('Pix','Credito','Debito','Boleto','Dinheiro')),
    CONSTRAINT CK_Pagamento_status CHECK (status IN ('Pago','Pendente','Atrasado','Estornado'))
);
GO

CREATE TABLE Aula (
    id_aula       INT IDENTITY(1,1) NOT NULL,
    id_modalidade TINYINT   NOT NULL,
    id_instrutor  SMALLINT  NOT NULL,
    data_aula     DATE      NOT NULL,
    horario       TIME(0)   NOT NULL,
    duracao       TINYINT   NOT NULL,              -- minutos
    capacidade    TINYINT   NOT NULL,
    CONSTRAINT PK_Aula PRIMARY KEY (id_aula),
    CONSTRAINT FK_Aula_Modalidade FOREIGN KEY (id_modalidade) REFERENCES Modalidade(id_modalidade),
    CONSTRAINT FK_Aula_Instrutor  FOREIGN KEY (id_instrutor)  REFERENCES Instrutor(id_instrutor),
    CONSTRAINT CK_Aula_duracao    CHECK (duracao > 0),
    CONSTRAINT CK_Aula_capacidade CHECK (capacidade > 0)
);
GO

CREATE TABLE Presenca (                             -- resolve N x N Aluno x Aula
    id_presenca INT IDENTITY(1,1) NOT NULL,
    id_aluno    INT NOT NULL,
    id_aula     INT NOT NULL,
    presente    BIT NOT NULL CONSTRAINT DF_Presenca_presente DEFAULT 1,
    CONSTRAINT PK_Presenca PRIMARY KEY (id_presenca),
    CONSTRAINT FK_Presenca_Aluno FOREIGN KEY (id_aluno) REFERENCES Aluno(id_aluno),
    CONSTRAINT FK_Presenca_Aula  FOREIGN KEY (id_aula)  REFERENCES Aula(id_aula),
    CONSTRAINT UQ_Presenca_aluno_aula UNIQUE (id_aluno, id_aula)
);
GO

CREATE TABLE Avaliacao_Fisica (
    id_avaliacao       INT IDENTITY(1,1) NOT NULL,
    id_aluno           INT          NOT NULL,
    id_instrutor       SMALLINT     NOT NULL,
    data_avaliacao     DATE         NOT NULL,
    peso               DECIMAL(5,2) NOT NULL,
    altura             DECIMAL(4,2) NOT NULL,
    percentual_gordura DECIMAL(5,2) NULL,
    observacoes        VARCHAR(300) NULL,
    CONSTRAINT PK_Avaliacao_Fisica PRIMARY KEY (id_avaliacao),
    CONSTRAINT FK_Avaliacao_Aluno     FOREIGN KEY (id_aluno)     REFERENCES Aluno(id_aluno),
    CONSTRAINT FK_Avaliacao_Instrutor FOREIGN KEY (id_instrutor) REFERENCES Instrutor(id_instrutor),
    CONSTRAINT CK_Avaliacao_peso    CHECK (peso BETWEEN 20 AND 400),
    CONSTRAINT CK_Avaliacao_altura  CHECK (altura BETWEEN 0.50 AND 2.50),
    CONSTRAINT CK_Avaliacao_gordura CHECK (percentual_gordura IS NULL OR percentual_gordura BETWEEN 0 AND 100)
);
GO

CREATE TABLE Treino (
    id_treino    INT IDENTITY(1,1) NOT NULL,
    id_aluno     INT         NOT NULL,
    id_instrutor SMALLINT    NOT NULL,
    nome         VARCHAR(60) NOT NULL,
    objetivo     VARCHAR(60) NULL,
    data_criacao DATE        NOT NULL CONSTRAINT DF_Treino_data  DEFAULT (CAST(GETDATE() AS DATE)),
    ativo        BIT         NOT NULL CONSTRAINT DF_Treino_ativo DEFAULT 1,
    CONSTRAINT PK_Treino PRIMARY KEY (id_treino),
    CONSTRAINT FK_Treino_Aluno     FOREIGN KEY (id_aluno)     REFERENCES Aluno(id_aluno),
    CONSTRAINT FK_Treino_Instrutor FOREIGN KEY (id_instrutor) REFERENCES Instrutor(id_instrutor)
);
GO

CREATE TABLE Item_Treino (                          -- resolve N x N Treino x Exercicio
    id_item_treino INT IDENTITY(1,1) NOT NULL,
    id_treino      INT          NOT NULL,
    id_exercicio   SMALLINT     NOT NULL,
    series         TINYINT      NOT NULL,
    repeticoes     TINYINT      NOT NULL,
    carga          DECIMAL(5,2) NULL,
    CONSTRAINT PK_Item_Treino PRIMARY KEY (id_item_treino),
    CONSTRAINT FK_Item_Treino_Treino    FOREIGN KEY (id_treino)    REFERENCES Treino(id_treino),
    CONSTRAINT FK_Item_Treino_Exercicio FOREIGN KEY (id_exercicio) REFERENCES Exercicio(id_exercicio),
    CONSTRAINT UQ_Item_Treino UNIQUE (id_treino, id_exercicio),
    CONSTRAINT CK_Item_series     CHECK (series > 0),
    CONSTRAINT CK_Item_repeticoes CHECK (repeticoes > 0),
    CONSTRAINT CK_Item_carga      CHECK (carga IS NULL OR carga >= 0)
);
GO
